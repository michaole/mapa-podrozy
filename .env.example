# Copy to .env.local and fill in. All three are public by design (shipped to the browser):
# Supabase protects data with row-level security; restrict the Google key to your site's domain.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_GOOGLE_MAPS_API_KEY=AIza...
# Optional: a Map ID from Google Cloud (Map Management). Without it the free DEMO_MAP_ID is used.
VITE_GOOGLE_MAP_ID=
